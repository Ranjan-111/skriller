# Build-time dependency provisioning; runtime tokenizer never needs public egress.
ARG BROWSER_BASE=skriller-egress-browser@sha256:548ee64f786a3524f7114c76b4b487e16559a7cb330704014035cec747eed918
FROM ${BROWSER_BASE}
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken-cache PYTHONPATH=/app/src:/app/third_party/scrapling:/app/third_party/agent-reach:/app/third_party/scrapegraph-ai
COPY infra/egress/cleanup-requirements.txt /app/cleanup-requirements.txt
COPY --from=cleanup_wheels . /tmp/cleanup-wheels
RUN cd /tmp/cleanup-wheels && sha256sum -c SHA256SUMS \
    && pip install --no-index --find-links=/tmp/cleanup-wheels --no-deps -r /app/cleanup-requirements.txt \
    && rm -rf /tmp/cleanup-wheels
ADD --checksum=sha256:446a9538cb6c348e3516120d7c08b09f57c36495e2acfffe59a5bf8b0cfb1a2d https://openaipublic.blob.core.windows.net/encodings/o200k_base.tiktoken /opt/tiktoken-cache/fb374d419588a4632f3f557e76b4b70aebbca790
RUN chmod 755 /opt/tiktoken-cache && chmod 444 /opt/tiktoken-cache/*
COPY third_party/scrapegraph-ai/scrapegraphai /app/third_party/scrapegraph-ai/scrapegraphai
COPY src/skriller /app/src/skriller
COPY scripts/probes/offline_cleanup.py /app/offline_cleanup.py
ENTRYPOINT ["/usr/local/bin/guarded-worker"]
