ARG BASE_IMAGE=python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
FROM ${BASE_IMAGE}
RUN pip install --no-cache-dir PyYAML==6.0.3
WORKDIR /app
# Copy the existing helper implementation rather than recreating it.
COPY third_party/agent-reach/agent_reach /app/agent_reach
COPY src/skriller/security /app/skriller/security
COPY scripts/egress_proxy.py /app/egress_proxy.py
ENV PYTHONPATH=/app PYTHONDONTWRITEBYTECODE=1
USER 65532:65532
ENTRYPOINT ["python", "/app/egress_proxy.py", "--bind", "0.0.0.0"]
