{
  "components": {
    "schemas": {
      "Capability": {
        "additionalProperties": false,
        "properties": {
          "access_route": {
            "maxLength": 200,
            "title": "Access Route",
            "type": "string"
          },
          "allowed_fields": {
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "title": "Allowed Fields",
            "type": "array"
          },
          "auth_kind": {
            "enum": [
              "none",
              "oauth",
              "session",
              "api_key"
            ],
            "title": "Auth Kind",
            "type": "string"
          },
          "engineering_status": {
            "enum": [
              "planned",
              "implemented",
              "tested"
            ],
            "title": "Engineering Status",
            "type": "string"
          },
          "operation": {
            "enum": [
              "discover",
              "read",
              "analytics"
            ],
            "title": "Operation",
            "type": "string"
          },
          "operational_status": {
            "enum": [
              "experimental",
              "available",
              "needs_connection",
              "needs_access_agreement",
              "rate_limited",
              "unavailable"
            ],
            "title": "Operational Status",
            "type": "string"
          },
          "source": {
            "enum": [
              "linkedin",
              "reddit",
              "web",
              "github",
              "rss",
              "youtube",
              "x",
              "instagram",
              "facebook"
            ],
            "title": "Source",
            "type": "string"
          },
          "version": {
            "maxLength": 100,
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "source",
          "operation",
          "engineering_status",
          "operational_status",
          "access_route",
          "auth_kind",
          "version"
        ],
        "title": "Capability",
        "type": "object"
      },
      "Criterion": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Field",
            "type": "string"
          },
          "operator": {
            "enum": [
              "eq",
              "gte",
              "lte",
              "contains",
              "in",
              "recent"
            ],
            "title": "Operator",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "field",
          "operator",
          "value"
        ],
        "title": "Criterion",
        "type": "object"
      },
      "ExecutionContext": {
        "additionalProperties": false,
        "properties": {
          "actor_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Actor Id",
            "type": "string"
          },
          "attempt_budget": {
            "maximum": 200,
            "minimum": 0,
            "title": "Attempt Budget",
            "type": "integer"
          },
          "connection_ref": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Connection Ref"
          },
          "deadline": {
            "format": "date-time",
            "title": "Deadline",
            "type": "string"
          },
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "plan_revision": {
            "minimum": 1,
            "title": "Plan Revision",
            "type": "integer"
          },
          "reservation_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reservation Id"
          },
          "workspace_id": {
            "format": "uuid",
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "workspace_id",
          "job_id",
          "actor_id",
          "plan_revision",
          "deadline",
          "attempt_budget"
        ],
        "title": "ExecutionContext",
        "type": "object"
      },
      "Failure": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "auth_required",
              "auth_expired",
              "access_denied",
              "challenge_detected",
              "rate_limited",
              "quota_exhausted",
              "not_found",
              "unsupported_operation",
              "source_unavailable",
              "schema_invalid",
              "evidence_missing",
              "ambiguous_match",
              "deadline_exceeded",
              "budget_exhausted",
              "cancelled"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "maxLength": 500,
            "title": "Message",
            "type": "string"
          },
          "retry_after_seconds": {
            "anyOf": [
              {
                "maximum": 86400,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Retry After Seconds"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "Failure",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobSnapshot": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "state": {
            "enum": [
              "planned",
              "queued",
              "running",
              "waiting_for_connection",
              "paused",
              "completed",
              "partial",
              "failed",
              "cancelled"
            ],
            "title": "State",
            "type": "string"
          },
          "terminal_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Terminal Reason"
          },
          "version": {
            "minimum": 0.0,
            "title": "Version",
            "type": "integer"
          },
          "workspace_id": {
            "format": "uuid",
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "workspace_id",
          "state",
          "stage",
          "version"
        ],
        "title": "JobSnapshot",
        "type": "object"
      },
      "Limits": {
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "default": 300,
            "maximum": 300,
            "minimum": 1,
            "title": "Candidates",
            "type": "integer"
          },
          "currency_cap": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "default": "0",
            "title": "Currency Cap"
          },
          "deadline_seconds": {
            "default": 1200,
            "maximum": 1200,
            "minimum": 1,
            "title": "Deadline Seconds",
            "type": "integer"
          },
          "fetch_attempts": {
            "default": 200,
            "maximum": 200,
            "minimum": 0,
            "title": "Fetch Attempts",
            "type": "integer"
          },
          "llm_calls": {
            "default": 40,
            "maximum": 40,
            "minimum": 0,
            "title": "Llm Calls",
            "type": "integer"
          },
          "result_limit": {
            "default": 25,
            "maximum": 100,
            "minimum": 1,
            "title": "Result Limit",
            "type": "integer"
          },
          "search_calls": {
            "default": 20,
            "maximum": 20,
            "minimum": 0,
            "title": "Search Calls",
            "type": "integer"
          },
          "token_cap": {
            "default": 100000,
            "maximum": 100000,
            "minimum": 0,
            "title": "Token Cap",
            "type": "integer"
          }
        },
        "title": "Limits",
        "type": "object"
      },
      "ProgressEvent": {
        "additionalProperties": false,
        "properties": {
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "details"
        ],
        "title": "ProgressEvent",
        "type": "object"
      },
      "SearchPlan": {
        "additionalProperties": false,
        "properties": {
          "clarification": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Clarification"
          },
          "conversation_id": {
            "format": "uuid",
            "title": "Conversation Id",
            "type": "string"
          },
          "entity_type": {
            "enum": [
              "person",
              "company",
              "creator",
              "discussion"
            ],
            "title": "Entity Type",
            "type": "string"
          },
          "exclusions": {
            "items": {
              "$ref": "#/components/schemas/Criterion"
            },
            "maxItems": 20,
            "title": "Exclusions",
            "type": "array"
          },
          "freshness_days": {
            "anyOf": [
              {
                "maximum": 3650,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Freshness Days"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "must_have": {
            "items": {
              "$ref": "#/components/schemas/Criterion"
            },
            "maxItems": 20,
            "title": "Must Have",
            "type": "array"
          },
          "preferences": {
            "items": {
              "$ref": "#/components/schemas/Criterion"
            },
            "maxItems": 20,
            "title": "Preferences",
            "type": "array"
          },
          "requested_fields": {
            "items": {
              "type": "string"
            },
            "maxItems": 30,
            "title": "Requested Fields",
            "type": "array"
          },
          "revision": {
            "minimum": 1,
            "title": "Revision",
            "type": "integer"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "sources": {
            "items": {
              "enum": [
                "linkedin",
                "reddit",
                "web",
                "github",
                "rss",
                "youtube",
                "x",
                "instagram",
                "facebook"
              ],
              "type": "string"
            },
            "maxItems": 9,
            "title": "Sources",
            "type": "array"
          },
          "unsupported_criteria": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Unsupported Criteria",
            "type": "array"
          },
          "workspace_id": {
            "format": "uuid",
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "workspace_id",
          "conversation_id",
          "revision",
          "entity_type"
        ],
        "title": "SearchPlan",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Skriller",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready"
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "current_user_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Current User"
      }
    },
    "/v1/workspaces/{workspace_id}/jobs/{job_id}": {
      "get": {
        "operationId": "snapshot_v1_workspaces__workspace_id__jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Workspace Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobSnapshot"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Snapshot"
      }
    },
    "/v1/workspaces/{workspace_id}/jobs/{job_id}/events": {
      "get": {
        "operationId": "events_v1_workspaces__workspace_id__jobs__job_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Workspace Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "last-event-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Events"
      }
    }
  }
}
