SKRILLER_ENVIRONMENT=development
SKRILLER_DATABASE_URL=postgresql+psycopg://skriller:local-development@127.0.0.1:54329/skriller
SKRILLER_APPLICATION_DATABASE_URL=postgresql+psycopg://skriller_app:local-development@127.0.0.1:54329/skriller
SKRILLER_BROKER_URL=amqp://skriller:local-development@127.0.0.1:56729//
SKRILLER_ALLOW_DEMO_AUTH=false
# Local remains the default. S3 is explicit and requires verified bucket privacy.
SKRILLER_OBJECT_BACKEND=local
SKRILLER_OBJECT_DIRECTORY=.runtime/objects
SKRILLER_S3_BUCKET=
SKRILLER_S3_REGION=us-east-1
SKRILLER_S3_ENDPOINT_URL=
# Leave empty to use the SDK's configured workload role. Never commit real credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Configure real app identity separately from source logins.
SKRILLER_FIREBASE_PROJECT_ID=
# Free, keyless prototype search. No automatic paid-provider fallback.
SKRILLER_SEARCH_PROVIDER=exa_keyless
# Keep Exa search out of production until the account and product usage terms are reviewed.
SKRILLER_SEARCH_COMMERCIAL_TERMS_CONFIRMED=false
# Secrets belong only in ignored .env, never in chat or committed fixtures.
BRAVE_SEARCH_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Local models remain the default. Groq is explicit opt-in, without SDK retries.
SKRILLER_MODEL_PROVIDER=ollama
SKRILLER_OLLAMA_MODEL=llama3.2:3b
GROQ_API_KEY=
# Confirm the configured account has no paid billing before enabling Groq.
SKRILLER_GROQ_FREE_TIER_CONFIRMED=false

# Disabled until representative planner quality is verified. No model fallback.
SKRILLER_ENABLE_AI_PLANNING=false
# Optional local public-page collection via the reviewed GuardedProxy. No direct fallback.
# Production remains gated on the isolated collection deployment.
SKRILLER_PUBLIC_COLLECTION_PROXY_URL=
# Optional local extraction of saved pages; requires public collection above.
SKRILLER_ENABLE_PAGE_EXTRACTION=false
# Enable only after the installed immutable browser image/network gates pass.
SKRILLER_ENABLE_DYNAMIC_COLLECTION=false
SKRILLER_ENABLE_STEALTH_COLLECTION=false
SKRILLER_PUBLIC_BROWSER_IMAGE=
# Optional immutable local YouTube image; unset keeps indexed discovery only.
SKRILLER_PUBLIC_YOUTUBE_IMAGE=
