SKRILLER_ENVIRONMENT=development
SKRILLER_DATABASE_URL=postgresql+psycopg://skriller:local-development@127.0.0.1:54329/skriller
SKRILLER_APPLICATION_DATABASE_URL=postgresql+psycopg://skriller_app:local-development@127.0.0.1:54329/skriller
SKRILLER_BROKER_URL=amqp://skriller:local-development@127.0.0.1:56729//
SKRILLER_ALLOW_DEMO_AUTH=false
# Configure real app identity separately from source logins.
SKRILLER_FIREBASE_PROJECT_ID=
# Free, keyless prototype search. No automatic paid-provider fallback.
SKRILLER_SEARCH_PROVIDER=exa_keyless
# Secrets belong only in ignored .env, never in chat or committed fixtures.
BRAVE_SEARCH_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Local models remain the default. Groq is explicit opt-in, without SDK retries.
SKRILLER_MODEL_PROVIDER=ollama
GROQ_API_KEY=
# Confirm the configured account has no paid billing before enabling Groq.
SKRILLER_GROQ_FREE_TIER_CONFIRMED=false
